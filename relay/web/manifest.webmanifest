{
  "name": "Formless",
  "lang": "en",
  "dir": "auto",
  "short_name": "Formless",
  "description": "An agent that builds the Tools a task needs and keeps them.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "shortcuts": [
    {
      "name": "New Session",
      "short_name": "New",
      "description": "Start a new Session in Formless.",
      "url": "/?action=new-session",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Approvals",
      "short_name": "Approvals",
      "description": "Review pending approvals in Formless.",
      "url": "/?view=approvals",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "files", "accept": ["image/*", "text/*", "application/pdf"] }]
    }
  },
  "background_color": "#0f1211",
  "theme_color": "#0f1211",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
