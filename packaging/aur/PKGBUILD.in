# Maintainer: Athiwat Chunlakhan <731394+athiwatc@users.noreply.github.com>
# Rendered per release by scripts/render-packaging.sh (do not edit the
# version or checksum by hand).
pkgname=formless-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="A tool-building AI agent harness: define a task, and the agent builds the tools it needs"
arch=('x86_64')
url="https://github.com/athiwatc/formless"
license=('Apache-2.0')
# dbus: libdbus-1, for the keyring's Secret Service backend.
depends=('glibc' 'gcc-libs' 'dbus')
provides=('formless')
conflicts=('formless')
source=("https://github.com/athiwatc/formless/releases/download/v${pkgver}/formless-v${pkgver}-x86_64-unknown-linux-gnu.tar.gz")
sha256sums=('@SHA256_LINUX@')

package() {
  cd "formless-v${pkgver}-x86_64-unknown-linux-gnu"
  install -Dm755 formless "${pkgdir}/usr/bin/formless"
  install -Dm644 formless.1 "${pkgdir}/usr/share/man/man1/formless.1"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/formless/README.md"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  "${pkgdir}/usr/bin/formless" completions bash | install -Dm644 /dev/stdin "${pkgdir}/usr/share/bash-completion/completions/formless"
  "${pkgdir}/usr/bin/formless" completions zsh | install -Dm644 /dev/stdin "${pkgdir}/usr/share/zsh/site-functions/_formless"
  "${pkgdir}/usr/bin/formless" completions fish | install -Dm644 /dev/stdin "${pkgdir}/usr/share/fish/vendor_completions.d/formless.fish"
}
